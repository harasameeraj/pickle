{
  "name": "kitcheniq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "dev:phone": "HTTPS=1 vite --host",
    "deploy": "GH_PAGES=1 vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll && cd dist && rm -rf .git && git init -q && git checkout -q -b gh-pages && git add -A && git commit -q -m deploy && git push -f https://github.com/harasameeraj/pickle.git gh-pages"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "framer-motion": "11.11.17",
    "idb-keyval": "6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  }
}
